{
  "name": "wolfi-k8s-toolbox",
  "devDependencies": {
    "conventional-changelog-angular": "9.4.0",
    "semantic-release": "25.0.9"
  },
  "release": {
    "branches": [
      "master"
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "releaseRules": [
            {
              "type": "chore",
              "scope": "deps",
              "subject": "update cgr.dev/chainguard/wolfi-base:latest*",
              "release": "patch"
            }
          ],
          "preset": "angular"
        }
      ],
      [
        "@semantic-release/release-notes-generator",
        {
          "preset": "angular"
        }
      ],
      "@semantic-release/github"
    ],
    "preset": "angular"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24",
      "onFail": "warn"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12",
      "onFail": "warn"
    }
  }
}
